# ==============================================================================
# Cortexa Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production, testing)
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME="Cortexa API"
PROJECT_VERSION="0.1.0"

# CORS Allowed Origins (Comma separated string or JSON array)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration
POSTGRES_USER=cortexa
POSTGRES_PASSWORD=cortexa_secret_dev
POSTGRES_DB=cortexa_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Async SQLAlchemy connection string (for FastAPI app runtime)
DATABASE_URL=postgresql+asyncpg://cortexa:cortexa_secret_dev@postgres:5432/cortexa_db
# Sync connection string (for Alembic migrations if needed)
DATABASE_SYNC_URL=postgresql+psycopg2://cortexa:cortexa_secret_dev@postgres:5432/cortexa_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Web Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
